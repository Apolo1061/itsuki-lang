#pragma once

#include "ctypes.huki"

namespace ctypes {

    // --- Funciones de Clasificacion de Caracteres ---

    fn is_alnum(c: int) -> int {
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) {
            return 1;
        }
        return 0;
    }

    fn is_alpha(c: int) -> int {
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
            return 1;
        }
        return 0;
    }

    fn is_lower(c: int) -> int {
        if (c >= 'a' && c <= 'z') {
            return 1;
        }
        return 0;
    }

    fn is_upper(c: int) -> int {
        if (c >= 'A' && c <= 'Z') {
            return 1;
        }
        return 0;
    }

    fn is_digit(c: int) -> int {
        if (c >= '0' && c <= '9') {
            return 1;
        }
        return 0;
    }

    fn is_xdigit(c: int) -> int {
        if ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')) {
            return 1;
        }
        return 0;
    }

    fn is_octdigit(c: int) -> int {
        if (c >= '0' && c <= '7') {
            return 1;
        }
        return 0;
    }

    fn is_binary(c: int) -> int {
        if (c == '0' || c == '1') {
            return 1;
        }
        return 0;
    }

    fn is_cntrl(c: int) -> int {
        if ((c >= 0 && c <= 31) || c == 127) {
            return 1;
        }
        return 0;
    }

    fn is_graph(c: int) -> int {
        if (c >= 33 && c <= 126) {
            return 1;
        }
        return 0;
    }

    fn is_space(c: int) -> int {
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 11 || c == 12) {
            return 1;
        }
        return 0;
    }

    fn is_blank(c: int) -> int {
        if (c == ' ' || c == '\t') {
            return 1;
        }
        return 0;
    }

    fn is_print(c: int) -> int {
        if (c >= 32 && c <= 126) {
            return 1;
        }
        return 0;
    }

    fn is_punct(c: int) -> int {
        if (c >= 33 && c <= 126) {
            if (!is_alnum(c)) {
                return 1;
            }
        }
        return 0;
    }

    fn is_ascii(c: int) -> int {
        if (c >= 0 && c <= 127) {
            return 1;
        }
        return 0;
    }

    fn is_vowel(c: int) -> int {
        if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
            c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U') {
            return 1;
        }
        return 0;
    }

    fn is_consonant(c: int) -> int {
        if (is_alpha(c)) {
            if (!is_vowel(c)) {
                return 1;
            }
        }
        return 0;
    }

    // --- Funciones de Conversion y Manipulacion de Caracteres ---

    fn to_lower(c: int) -> int {
        if (c >= 'A' && c <= 'Z') {
            return c + 32;
        }
        return c;
    }

    fn to_upper(c: int) -> int {
        if (c >= 'a' && c <= 'z') {
            return c - 32;
        }
        return c;
    }

    fn to_ascii(c: int) -> int {
        return c & 127;
    }

    fn toggle_case(c: int) -> int {
        if (c >= 'A' && c <= 'Z') {
            return c + 32;
        }
        if (c >= 'a' && c <= 'z') {
            return c - 32;
        }
        return c;
    }

    fn digit_to_int(c: int) -> int {
        if (c >= '0' && c <= '9') {
            return c - '0';
        }
        return -1;
    }

    fn xdigit_to_int(c: int) -> int {
        if (c >= '0' && c <= '9') {
            return c - '0';
        }
        if (c >= 'a' && c <= 'f') {
            return c - 'a' + 10;
        }
        if (c >= 'A' && c <= 'F') {
            return c - 'A' + 10;
        }
        return -1;
    }

    fn int_to_digit(val: int) -> int {
        if (val >= 0 && val <= 9) {
            return '0' + val;
        }
        return -1;
    }

    fn int_to_xdigit(val: int, uppercase: int) -> int {
        if (val >= 0 && val <= 9) {
            return '0' + val;
        }
        if (val >= 10 && val <= 15) {
            if (uppercase != 0) {
                return 'A' + (val - 10);
            } else {
                return 'a' + (val - 10);
            }
        }
        return -1;
    }

    // --- Alias clasicos compatibles con C (ctype.h) ---

    fn isalnum(c: int) -> int { return is_alnum(c); }
    fn isalpha(c: int) -> int { return is_alpha(c); }
    fn islower(c: int) -> int { return is_lower(c); }
    fn isupper(c: int) -> int { return is_upper(c); }
    fn isdigit(c: int) -> int { return is_digit(c); }
    fn isxdigit(c: int) -> int { return is_xdigit(c); }
    fn iscntrl(c: int) -> int { return is_cntrl(c); }
    fn isgraph(c: int) -> int { return is_graph(c); }
    fn isspace(c: int) -> int { return is_space(c); }
    fn isblank(c: int) -> int { return is_blank(c); }
    fn isprint(c: int) -> int { return is_print(c); }
    fn ispunct(c: int) -> int { return is_punct(c); }
    fn isascii(c: int) -> int { return is_ascii(c); }
    fn tolower(c: int) -> int { return to_lower(c); }
    fn toupper(c: int) -> int { return to_upper(c); }
    fn toascii(c: int) -> int { return to_ascii(c); }

    // --- Predicados y utilidades para Cadenas ---

    fn str_is_alpha(s: char*) -> int {
        if (s == 0 || s[0] == 0) { return 0; }
        var i: int = 0;
        while (s[i] != 0) {
            if (!is_alpha(s[i])) {
                return 0;
            }
            i++;
        }
        return 1;
    }

    fn str_is_digit(s: char*) -> int {
        if (s == 0 || s[0] == 0) { return 0; }
        var i: int = 0;
        while (s[i] != 0) {
            if (!is_digit(s[i])) {
                return 0;
            }
            i++;
        }
        return 1;
    }

    fn str_is_alnum(s: char*) -> int {
        if (s == 0 || s[0] == 0) { return 0; }
        var i: int = 0;
        while (s[i] != 0) {
            if (!is_alnum(s[i])) {
                return 0;
            }
            i++;
        }
        return 1;
    }

    fn str_is_xdigit(s: char*) -> int {
        if (s == 0 || s[0] == 0) { return 0; }
        var i: int = 0;
        while (s[i] != 0) {
            if (!is_xdigit(s[i])) {
                return 0;
            }
            i++;
        }
        return 1;
    }

    fn str_is_space(s: char*) -> int {
        if (s == 0 || s[0] == 0) { return 0; }
        var i: int = 0;
        while (s[i] != 0) {
            if (!is_space(s[i])) {
                return 0;
            }
            i++;
        }
        return 1;
    }

    fn str_is_lower(s: char*) -> int {
        if (s == 0 || s[0] == 0) { return 0; }
        var i: int = 0;
        var has_alpha: int = 0;
        while (s[i] != 0) {
            if (is_upper(s[i])) {
                return 0;
            }
            if (is_lower(s[i])) {
                has_alpha = 1;
            }
            i++;
        }
        return has_alpha;
    }

    fn str_is_upper(s: char*) -> int {
        if (s == 0 || s[0] == 0) { return 0; }
        var i: int = 0;
        var has_alpha: int = 0;
        while (s[i] != 0) {
            if (is_lower(s[i])) {
                return 0;
            }
            if (is_upper(s[i])) {
                has_alpha = 1;
            }
            i++;
        }
        return has_alpha;
    }

    fn str_is_ascii(s: char*) -> int {
        if (s == 0) { return 0; }
        var i: int = 0;
        while (s[i] != 0) {
            if (!is_ascii(s[i])) {
                return 0;
            }
            i++;
        }
        return 1;
    }

    fn str_count_digits(s: char*) -> int {
        if (s == 0) { return 0; }
        var i: int = 0;
        var count: int = 0;
        while (s[i] != 0) {
            if (is_digit(s[i])) {
                count++;
            }
            i++;
        }
        return count;
    }

    fn str_count_alpha(s: char*) -> int {
        if (s == 0) { return 0; }
        var i: int = 0;
        var count: int = 0;
        while (s[i] != 0) {
            if (is_alpha(s[i])) {
                count++;
            }
            i++;
        }
        return count;
    }

    fn str_count_spaces(s: char*) -> int {
        if (s == 0) { return 0; }
        var i: int = 0;
        var count: int = 0;
        while (s[i] != 0) {
            if (is_space(s[i])) {
                count++;
            }
            i++;
        }
        return count;
    }
}

// Implementacion de los wrappers globales
fn isalnum(c: int) -> int { return ctypes::is_alnum(c); }
fn isalpha(c: int) -> int { return ctypes::is_alpha(c); }
fn islower(c: int) -> int { return ctypes::is_lower(c); }
fn isupper(c: int) -> int { return ctypes::is_upper(c); }
fn isdigit(c: int) -> int { return ctypes::is_digit(c); }
fn isxdigit(c: int) -> int { return ctypes::is_xdigit(c); }
fn iscntrl(c: int) -> int { return ctypes::is_cntrl(c); }
fn isgraph(c: int) -> int { return ctypes::is_graph(c); }
fn isspace(c: int) -> int { return ctypes::is_space(c); }
fn isblank(c: int) -> int { return ctypes::is_blank(c); }
fn isprint(c: int) -> int { return ctypes::is_print(c); }
fn ispunct(c: int) -> int { return ctypes::is_punct(c); }
fn isascii(c: int) -> int { return ctypes::is_ascii(c); }
fn tolower(c: int) -> int { return ctypes::to_lower(c); }
fn toupper(c: int) -> int { return ctypes::to_upper(c); }
fn toascii(c: int) -> int { return ctypes::to_ascii(c); }
