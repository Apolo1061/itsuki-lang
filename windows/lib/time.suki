#pragma once

#define _TIME_HUKI_INSIDE_SUKI_ 1
#include "time.huki"

#ifdef _WIN32
extern "C" {
    fn _time32(t: void*) -> int;
    fn _localtime32(t: void*) -> struct tm*;
    fn _gmtime32(t: void*) -> struct tm*;
}
#define sys_time_now(t) _time32(t)
#define sys_time_local(t) _localtime32(t)
#define sys_time_utc(t) _gmtime32(t)
#else
extern "C" {
    fn time(t: void*) -> int;
    fn localtime(t: void*) -> struct tm*;
    fn gmtime(t: void*) -> struct tm*;
}
#define sys_time_now(t) time(t)
#define sys_time_local(t) localtime(t)
#define sys_time_utc(t) gmtime(t)
#endif

namespace time {

    // --- Obtención de Tiempo y Cronometrado ---

    fn now() -> int {
        return sys_time_now(0);
    }

    fn sec() -> int {
        return sys_time_now(0);
    }

    fn ms() -> int {
        return fundamental::get_tick_count();
    }

    fn clock_ms() -> int {
        return fundamental::get_tick_count();
    }

    fn sleep(ms: int) -> void {
        fundamental::sleep(ms);
    }

    fn sleep_sec(seconds: int) -> void {
        if (seconds > 0) {
            fundamental::sleep(seconds * 1000);
        }
    }

    fn diff_sec(start_sec: int, end_sec: int) -> int {
        return end_sec - start_sec;
    }

    fn diff_ms(start_ms: int, end_ms: int) -> int {
        return end_ms - start_ms;
    }

    // --- Cálculos de Calendario ---

    fn is_leap_year(year: int) -> int {
        if (year % 4 != 0) { return 0; }
        if (year % 100 != 0) { return 1; }
        if (year % 400 != 0) { return 0; }
        return 1;
    }

    fn days_in_month(year: int, month: int) -> int {
        if (month < 1 || month > 12) { return 0; }
        if (month == 2) {
            return is_leap_year(year) ? 29 : 28;
        }
        if (month == 4 || month == 6 || month == 9 || month == 11) {
            return 30;
        }
        return 31;
    }

    fn day_of_week(year: int, month: int, day: int) -> int {
        var y = year;
        if (month < 3) {
            y = y - 1;
        }
        var t = 0;
        if (month == 1) { t = 0; }
        else if (month == 2) { t = 3; }
        else if (month == 3) { t = 2; }
        else if (month == 4) { t = 5; }
        else if (month == 5) { t = 0; }
        else if (month == 6) { t = 3; }
        else if (month == 7) { t = 5; }
        else if (month == 8) { t = 1; }
        else if (month == 9) { t = 4; }
        else if (month == 10) { t = 6; }
        else if (month == 11) { t = 2; }
        else if (month == 12) { t = 4; }

        var w = (y + y / 4 - y / 100 + y / 400 + t + day) % 7;
        if (w < 0) { w = w + 7; }
        return w;
    }

    fn day_of_year(year: int, month: int, day: int) -> int {
        var total = 0;
        for (var m = 1; m < month; m++) {
            total = total + days_in_month(year, m);
        }
        return total + day;
    }

    // --- Conversión y Desglose ---

    fn to_datetime(timestamp: int, dt: struct DateTime*) -> void {
        if (dt == 0) { return; }
        if (timestamp < 0) { timestamp = 0; }

        var rem = timestamp;
        dt->sec = rem % 60;
        rem = rem / 60;
        dt->min = rem % 60;
        rem = rem / 60;
        dt->hour = rem % 24;
        var days = rem / 24;

        dt->wday = (4 + days) % 7;

        var y = 1970;
        while (1) {
            var diy = is_leap_year(y) ? 366 : 365;
            if (days < diy) {
                break;
            }
            days = days - diy;
            y++;
        }
        dt->year = y;
        dt->yday = days + 1;

        var m = 1;
        while (m <= 12) {
            var dim = days_in_month(y, m);
            if (days < dim) {
                break;
            }
            days = days - dim;
            m++;
        }
        dt->month = m;
        dt->day = days + 1;
        dt->is_dst = 0;
    }

    fn to_timestamp(dt: struct DateTime*) -> int {
        if (dt == 0) { return 0; }
        var days = 0;
        for (var y = 1970; y < dt->year; y++) {
            days = days + (is_leap_year(y) ? 366 : 365);
        }
        for (var m = 1; m < dt->month; m++) {
            days = days + days_in_month(dt->year, m);
        }
        days = days + (dt->day - 1);
        var total_sec = days * 86400 + dt->hour * 3600 + dt->min * 60 + dt->sec;
        return total_sec;
    }

    fn local(dt: struct DateTime*) -> void {
        if (dt == 0) { return; }
        var now_sec = now();
        var ptm = sys_time_local(&now_sec);
        if (ptm != 0) {
            dt->year = ptm->tm_year + 1900;
            dt->month = ptm->tm_mon + 1;
            dt->day = ptm->tm_mday;
            dt->hour = ptm->tm_hour;
            dt->min = ptm->tm_min;
            dt->sec = ptm->tm_sec;
            dt->wday = ptm->tm_wday;
            dt->yday = ptm->tm_yday + 1;
            dt->is_dst = ptm->tm_isdst;
        } else {
            to_datetime(now_sec, dt);
        }
    }

    fn utc(dt: struct DateTime*) -> void {
        if (dt == 0) { return; }
        var now_sec = now();
        var ptm = sys_time_utc(&now_sec);
        if (ptm != 0) {
            dt->year = ptm->tm_year + 1900;
            dt->month = ptm->tm_mon + 1;
            dt->day = ptm->tm_mday;
            dt->hour = ptm->tm_hour;
            dt->min = ptm->tm_min;
            dt->sec = ptm->tm_sec;
            dt->wday = ptm->tm_wday;
            dt->yday = ptm->tm_yday + 1;
            dt->is_dst = ptm->tm_isdst;
        } else {
            to_datetime(now_sec, dt);
        }
    }

    // --- Formato de Cadenas ---

    fn format(dt: struct DateTime*, buf: char*, max_len: int) -> char* {
        if (dt == 0 || buf == 0 || max_len <= 0) { return ""; }
        snprintf(buf, max_len, "%04d-%02d-%02d %02d:%02d:%02d",
            dt->year, dt->month, dt->day, dt->hour, dt->min, dt->sec);
        return buf;
    }

    fn format_date(dt: struct DateTime*, buf: char*, max_len: int) -> char* {
        if (dt == 0 || buf == 0 || max_len <= 0) { return ""; }
        snprintf(buf, max_len, "%04d-%02d-%02d", dt->year, dt->month, dt->day);
        return buf;
    }

    fn format_time(dt: struct DateTime*, buf: char*, max_len: int) -> char* {
        if (dt == 0 || buf == 0 || max_len <= 0) { return ""; }
        snprintf(buf, max_len, "%02d:%02d:%02d", dt->hour, dt->min, dt->sec);
        return buf;
    }

    fn str_now(buf: char*, max_len: int) -> char* {
        if (buf == 0 || max_len <= 0) { return ""; }
        var dt: struct DateTime;
        local(&dt);
        return format(&dt, buf, max_len);
    }

    fn day_name(wday: int) -> char* {
        if (wday == 0) { return "Domingo"; }
        if (wday == 1) { return "Lunes"; }
        if (wday == 2) { return "Martes"; }
        if (wday == 3) { return "Miercoles"; }
        if (wday == 4) { return "Jueves"; }
        if (wday == 5) { return "Viernes"; }
        if (wday == 6) { return "Sabado"; }
        return "Desconocido";
    }

    fn month_name(month: int) -> char* {
        if (month == 1) { return "Enero"; }
        if (month == 2) { return "Febrero"; }
        if (month == 3) { return "Marzo"; }
        if (month == 4) { return "Abril"; }
        if (month == 5) { return "Mayo"; }
        if (month == 6) { return "Junio"; }
        if (month == 7) { return "Julio"; }
        if (month == 8) { return "Agosto"; }
        if (month == 9) { return "Septiembre"; }
        if (month == 10) { return "Octubre"; }
        if (month == 11) { return "Noviembre"; }
        if (month == 12) { return "Diciembre"; }
        return "Desconocido";
    }

    // --- Medición de Rendimiento (Benchmark) ---

    fn benchmark_start(b: struct Benchmark*) -> void {
        if (b == 0) { return; }
        b->start_ms = fundamental::get_tick_count();
        b->end_ms = 0;
        b->elapsed_ms = 0;
    }

    fn benchmark_stop(b: struct Benchmark*) -> int {
        if (b == 0) { return 0; }
        b->end_ms = fundamental::get_tick_count();
        b->elapsed_ms = b->end_ms - b->start_ms;
        return b->elapsed_ms;
    }

    fn benchmark_elapsed(b: struct Benchmark*) -> int {
        if (b == 0) { return 0; }
        if (b->end_ms > 0) {
            return b->elapsed_ms;
        }
        return fundamental::get_tick_count() - b->start_ms;
    }
}
