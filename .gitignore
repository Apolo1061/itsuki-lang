# ===========================================================
# Itsuki Programming Language - .gitignore
# ===========================================================

# Archivos objeto y temporales de compilacion
*.o
*.obj
*.tmp
*.tmp.*
*.out
*.exe.stackdump

# Archivos de ensamblador generados temporalmente (no runtime.s)
*.s
!lib/runtime.s
!windows/lib/runtime.s
!linux/lib/runtime.s
!build/**/runtime.s

# Binarios temporales de prueba locales
linux/build/
windows/build/
cosas.exe
code.exe
compilador.exe
test_master_suite
Mensaje

# Archivos de depuración y enlaces temporales
*.pdb
*.ilk
*.idb

# Configuraciones de editores y sistemas operativos
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
